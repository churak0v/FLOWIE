# Copy to .env.production on the production host. Never commit the real file.
# Historical public domain found in the saved project copy; verify DNS ownership first.
FLOWIE_DOMAIN=flowie.art
FLOWIE_ADMIN_DOMAIN=admin.flowie.art
PUBLIC_SITE_URL=https://flowie.art
APP_COOKIE_DOMAIN=.flowie.art
AUTH_ALLOWED_ORIGINS=https://flowie.art,https://admin.flowie.art
TLS_CERT_DIR=/etc/flowie/tls

# Immutable identifier of the source being released, preferably a full Git SHA.
RELEASE_TAG=replace-with-full-git-sha

POSTGRES_USER=flowie
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=flowie
# Keep this password synchronized with POSTGRES_PASSWORD and URL-encode reserved characters.
DATABASE_URL=postgresql://flowie:replace-with-url-encoded-password@db:5432/flowie?schema=public

APP_JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_LOGIN=replace-with-admin-login
# Generate with: node -e "console.log(require('./server/services/adminCredentials').passwordHash(process.argv[1]))" 'long-random-password'
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
ADMIN_DISPLAY_NAME=Администратор
# Disabled until production credentials, callback behavior and a controlled order are approved.
ALFA_BANK_ENABLED=false
ALFA_BANK_MODE=test
ALFA_BANK_API_URL=
ALFA_BANK_USER_NAME=
ALFA_BANK_PASSWORD=
# Optional token instead of API login/password. For r-merchants set API_URL=https://payment.alfabank.ru/payment/rest
ALFA_BANK_TOKEN=
ALFA_TAX_SYSTEM=1
ALFA_TAX_TYPE=0
TELEGRAM_ORDER_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_IDS=
TELEGRAM_ORDER_ADMIN_URL=https://admin.flowie.art
TELEGRAM_ORDER_API_BASE=https://api.telegram.org

# Demonstration automation is prohibited in production by application code.
AUTO_FULFILLMENT_ENABLED=false
AUTO_FULFILLMENT_INTERVAL_MS=60000

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FLOWIE/production (replace-with-contact)
PAYMENT_BANK_NAME=
PAYMENT_CARD_NUMBER=
PAYMENT_RECEIVER_NAME=
RUB_PER_USD=
SPB_LO_VIEWBOX=
DELIVERY_TARIFF_RUB=
DELIVERY_INVOICE_TTL_HOURS=24

# JS key is public and must be restricted to storefront/admin HTTP Referers.
# Suggest/geocoder keys remain on the API server. Enable after configuring all products.
YANDEX_MAPS_ENABLED=false
YANDEX_MAPS_JS_API_KEY=
YANDEX_MAPS_SUGGEST_API_KEY=
YANDEX_MAPS_GEOCODER_API_KEY=

# Optional semantic catalog search. Keep API key on the server only.
CATALOG_EMBEDDINGS_ENABLED=false
OPENAI_API_KEY=
# Origin/prefix without /v1; FLOWIE production uses the IP-restricted SPEKA relay.
OPENAI_API_BASE_URL=https://speka.tech/flowie-openai
FLOWIE_IMPORT_AI_MODE=sync
FLOWIE_IMPORT_AI_CONCURRENCY=2
CATALOG_EMBEDDING_MODEL=text-embedding-3-small
CATALOG_EMBEDDING_DIMENSIONS=512
CATALOG_EMBEDDING_TIMEOUT_MS=2500
CATALOG_SEARCH_MIN_SIMILARITY=0.25
CATALOG_REINDEX_MAX_PRODUCTS=2000
CATALOG_REINDEX_BATCH_SIZE=20

# SMS.ru authentication is disabled until the auth handoff is reviewed.
SMS_AUTH_ENABLED=false
SMS_RU_API_ID=
SMS_RU_SENDER=
VITE_HERO_IMAGE=
VITE_RECIPIENT_IMAGE=
VITE_YANDEX_METRICA_ID=
VITE_VK_PIXEL_ID=

# Local dev (host machine):
# DATABASE_URL=postgresql://flowie:flowie@localhost:54321/flowie?schema=public
DATABASE_URL=postgresql://flowie:flowie@db:5432/flowie?schema=public

# JWT secret for your app sessions (secret)
APP_JWT_SECRET=change-me

# Cookie domain (optional, e.g. .flowie.app)
APP_COOKIE_DOMAIN=

# development|production
NODE_ENV=development
AUTH_ALLOWED_ORIGINS=

# Phone allowed to bootstrap the first admin after SMS verification
ADMIN_PHONE=

# Payments
ALFA_BANK_ENABLED=false
ALFA_BANK_MODE=test
ALFA_BANK_API_URL=
ALFA_BANK_USER_NAME=
ALFA_BANK_PASSWORD=
# Optional token instead of API login/password. For r-merchants set API_URL=https://payment.alfabank.ru/payment/rest
ALFA_BANK_TOKEN=
# Fiscal receipt settings: 1 = USN income; 0 = without VAT.
ALFA_TAX_SYSTEM=1
ALFA_TAX_TYPE=0
TELEGRAM_ORDER_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_IDS=
TELEGRAM_ORDER_ADMIN_URL=https://admin.flowie.art
TELEGRAM_ORDER_API_BASE=https://api.telegram.org

# Delivery/SMS (integration disabled by default)
DELIVERY_TARIFF_RUB=
DELIVERY_INVOICE_TTL_HOURS=24
YANDEX_MAPS_ENABLED=false
YANDEX_MAPS_JS_API_KEY=
YANDEX_MAPS_SUGGEST_API_KEY=
YANDEX_MAPS_GEOCODER_API_KEY=

# Optional semantic catalog search. Keep API key on the server only.
CATALOG_EMBEDDINGS_ENABLED=false
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
CATALOG_EMBEDDING_MODEL=text-embedding-3-small
CATALOG_EMBEDDING_DIMENSIONS=512
CATALOG_EMBEDDING_TIMEOUT_MS=2500
CATALOG_SEARCH_MIN_SIMILARITY=0.25
CATALOG_REINDEX_MAX_PRODUCTS=2000
CATALOG_REINDEX_BATCH_SIZE=20
SMS_AUTH_ENABLED=false
SMS_RU_API_ID=
SMS_RU_SENDER=

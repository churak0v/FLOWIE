generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Private import state; never included in public product serializers.
model BouquetImportBatch {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  status    String   @default("COLLECTING")
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, userId, status])
}

model BouquetImportUpdate {
  updateId  String   @id
  createdAt DateTime @default(now())
}

model FlowerPurchasePrice {
  id            String   @id @default(cuid())
  supplierId    String
  ingredientId  String
  name          String
  unit          String
  priceKopecks  Int
  effectiveAt   DateTime
  source        String
  confirmed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([supplierId, ingredientId, unit, effectiveAt])
}

model BouquetRecipe {
  id          String   @id @default(cuid())
  productId   Int?     @unique
  importId    String?
  name        String
  lines       Json
  costs       Json
  snapshot    Json?
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum StaffRole {
  admin
  moderator
  florist
  courier
}

enum CollectionType {
  thematic
  scenario
}

enum ChatSenderRole {
  client
  staff
}

model User {
  id              Int           @id @default(autoincrement())
  name            String?
  username        String?
  phone           String?
  verifiedPhone   String?       @unique
  phoneVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  consentPersonal Boolean       @default(false)
  referralLinkId  Int?
  referralLink    ReferralLink? @relation("UserReferral", fields: [referralLinkId], references: [id], onDelete: SetNull)
  referralSource  String?
  referralAt      DateTime?

  // Staff access (admin panel)
  staffRole   StaffRole?
  staffActive Boolean    @default(false)

  orders        Order[]
  courierOrders Order[]     @relation("OrderCourier")
  recipients    Recipient[]
  addresses     Address[]
  auditLogs     AuditLog[]

  // Client chats + promo codes
  chats                Chat[]
  promoCodes           PromoCode[]          @relation("PromoCode_User")
  promoCodesCreated    PromoCode[]          @relation("PromoCode_CreatedBy")
  OrderStatusHistory   OrderStatusHistory[]
  OrderPhoto           OrderPhoto[]
  AnalyticsEvent       AnalyticsEvent[]
  referralLinksCreated ReferralLink[]       @relation("ReferralCreatedBy")
  referralOpens        ReferralOpen[]       @relation("ReferralOpenUser")
  authSessions         AuthSession[]
  phoneOtpChallenges   PhoneOtpChallenge[]
  staffCredential      StaffCredential?
}

model StaffCredential {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  login        String   @unique @db.VarChar(64)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuthSession {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  lastSeenAt    DateTime  @default(now())
  ipHash        String?
  userAgentHash String?

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model PhoneOtpChallenge {
  id                String    @id @default(cuid())
  phone             String
  codeHash          String
  userId            Int?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash            String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  resendAfter       DateTime
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  consumedAt        DateTime?
  providerMessageId String?

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
  @@index([expiresAt])
}

model Address {
  id          Int     @id @default(autoincrement())
  userId      Int
  user        User    @relation(fields: [userId], references: [id])
  label       String? // e.g. "Home", "Office"
  fullAddress String
  coords      String? // "lat,long"
  comment     String?
}

model Product {
  id              Int                      @id @default(autoincrement())
  name            String
  price           Int
  discount        Int                      @default(0)
  image           String
  description     String?
  tags            String // Stored as comma separated
  deliveryTime    String?
  color           String?
  width           Int?
  height          Int?
  isUpsell        Boolean                  @default(false)
  upsellSort      Int                      @default(0)
  sort            Int                      @default(0)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  orderItems      OrderItem[]
  images          ProductImage[]
  composition     ProductCompositionItem[]
  collectionItems CollectionItem[]
  embedding       ProductEmbedding?
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  url       String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductCompositionItem {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  quantity  String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sort])
}

model Collection {
  id          Int            @id @default(autoincrement())
  type        CollectionType @default(thematic)
  slug        String         @unique
  title       String
  description String?
  isActive    Boolean        @default(true)
  sort        Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items CollectionItem[]
}

model CollectionItem {
  id           Int @id @default(autoincrement())
  collectionId Int
  productId    Int
  sort         Int @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, sort])
}

model Order {
  id                     Int       @id @default(autoincrement())
  checkoutKey            String?   @unique
  userId                 Int
  user                   User      @relation(fields: [userId], references: [id])
  status                 String // "new", "paid", "delivery", "completed", "cancelled"
  cancelReason           String?
  floristComment         String?
  senderPhone            String?
  consentPersonal        Boolean   @default(false)
  paymentMethod          String?
  paymentStatus          String    @default("PENDING")
  paymentClientConfirmed Boolean   @default(false)
  paymentPayload         String?
  paymentChargeId        String?
  paymentMeta            String?
  paymentExpiresAt       DateTime?
  paidAt                 DateTime?
  preDeliveryRating      String?
  preDeliveryRatedAt     DateTime?
  courierId              Int?
  courier                User?     @relation("OrderCourier", fields: [courierId], references: [id])
  deliveredAt            DateTime?
  analyticsSessionId     String?   @db.VarChar(96)
  analyticsAttribution   Json?

  // Financials
  itemsTotal     Int
  deliveryCost   Int?
  totalPrice     Int
  referralLinkId Int?
  referralLink   ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)

  // Delivery Info
  deliveryAddress     String?
  deliveryCoords      String?
  deliveryTime        String?
  recipientName       String?
  recipientPhone      String?
  askRecipientAddress Boolean          @default(false)
  askRecipientTime    Boolean          @default(false)
  deliveryStatus      String           @default("DETAILS_PENDING")
  deliveryQuoteKey    String?          @unique @db.VarChar(64)
  deliveryQuoteDigest String?          @db.VarChar(64)
  deliveryInvoice     DeliveryInvoice?

  createdAt DateTime    @default(now())
  items     OrderItem[]

  statusHistory         OrderStatusHistory[]
  photos                OrderPhoto[]
  chats                 Chat[]
  promoCodes            PromoCode[]
  telegramNotifications TelegramOrderNotification[]

  @@index([courierId])
  @@index([referralLinkId, createdAt])
  @@index([analyticsSessionId])
}

model TelegramOrderNotification {
  id            Int       @id @default(autoincrement())
  orderId       Int
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event         String    @db.VarChar(40)
  chatId        String    @db.VarChar(32)
  status        String    @default("PENDING") @db.VarChar(20)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orderId, event, chatId])
  @@index([status, nextAttemptAt])
}

model DeliveryInvoice {
  id               Int       @id @default(autoincrement())
  orderId          Int       @unique
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount           Int
  currency         String    @default("643") @db.VarChar(3)
  status           String    @default("PAYMENT_PENDING")
  paymentChargeId  String?   @unique
  paymentMeta      String?
  paymentExpiresAt DateTime
  paidAt           DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, paymentExpiresAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int // Snapshot of price at purchase
}

model Recipient {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  name       String
  relation   String?
  phone      String?
  address    String?
  birthDate  String?
  askAddress Boolean  @default(false)
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  actorId   Int?
  actor     User?    @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderPhoto {
  id             Int       @id @default(autoincrement())
  orderId        Int
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url            String
  uploadedById   Int?
  uploadedBy     User?     @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime  @default(now())
  sentToClientAt DateTime?

  @@index([orderId, createdAt])
}

model Chat {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId, updatedAt])
  @@index([orderId])
}

model Message {
  id            Int            @id @default(autoincrement())
  chatId        Int
  chat          Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderRole    ChatSenderRole
  senderUserId  Int?
  text          String?
  attachmentUrl String?
  createdAt     DateTime       @default(now())

  @@index([chatId, createdAt])
}

model PromoCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  amount     Int
  expiresAt  DateTime?
  sentAt     DateTime?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  userId Int?
  user   User? @relation("PromoCode_User", fields: [userId], references: [id], onDelete: SetNull)

  orderId Int?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdById Int
  createdBy   User @relation("PromoCode_CreatedBy", fields: [createdById], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([orderId])
}

model WorkingHours {
  id        Int      @id @default(autoincrement())
  weekday   Int // 0..6 (Mon..Sun)
  startTime String? // "09:00"
  endTime   String? // "21:00"
  isClosed  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([weekday])
}

model WorkingHoursException {
  id        Int      @id @default(autoincrement())
  date      DateTime // date at 00:00:00
  startTime String?
  endTime   String?
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([date])
}

model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  eventId   String?  @unique @db.VarChar(96)
  schemaVersion Int   @default(1)
  sessionId String?   @db.VarChar(96)
  pageViewId String?  @db.VarChar(96)
  routeKey  String?   @db.VarChar(64)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  productId Int?
  orderId   Int?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([event, routeKey, createdAt])
  @@index([productId, event, createdAt])
}

model ReferralLink {
  id          Int      @id @default(autoincrement())
  tag         String   @unique
  title       String?
  note        String?
  isActive    Boolean  @default(true)
  autoCreated Boolean  @default(false)
  createdById Int?
  createdBy   User?    @relation("ReferralCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opens  ReferralOpen[]
  orders Order[]
  users  User[]         @relation("UserReferral")

  @@index([createdAt])
}

model ReferralOpen {
  id             Int          @id @default(autoincrement())
  referralLinkId Int
  referralLink   ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?        @relation("ReferralOpenUser", fields: [userId], references: [id], onDelete: SetNull)
  source         String?
  href           String?
  createdAt      DateTime     @default(now())

  @@index([referralLinkId, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ProductEmbedding {
  id              Int      @id @default(autoincrement())
  productId       Int      @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  contentHash     String   @db.VarChar(64)
  documentVersion String   @db.VarChar(40)
  model           String   @db.VarChar(100)
  dimensions      Int
  vector          Float[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([model, dimensions, documentVersion])
}

model DeliveryZone {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(80)
  price      Int?
  conditions String   @default("") @db.VarChar(500)
  priority   Int      @default(100)
  active     Boolean  @default(false)
  polygon    Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, priority])
}

model HomeBanner {
  id            String   @id @db.VarChar(32)
  caption       String   @db.VarChar(100)
  subtitle      String   @default("") @db.VarChar(220)
  image         String   @db.VarChar(500)
  href          String   @default("/catalog") @db.VarChar(300)
  imagePosition String   @default("center 58%") @db.VarChar(60)
  sort          Int      @default(0)
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@index([isActive, sort])
}

model DeliverySettings {
  id        Int      @id @default(1)
  mode      String   @default("flat") @db.VarChar(10)
  updatedAt DateTime @updatedAt
}
